# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: ORACLE AUTONOMOUS DATABASE (Uncomment on your Oracle VM .env only if linking external Oracle ADB)
# With One-Way TLS (mTLS OFF) on Oracle ADB, NO wallet directory or wallet password is needed at all:
# ORACLE_USER="ADMIN"
# ORACLE_PASSWORD=""
# ORACLE_CONNECT_STRING=""
# ORACLE_WALLET_DIR=""
# ORACLE_WALLET_PASSWORD=""

# Optional: Hands-Free 24x7 Oracle VM Auto-Login (Uncomment in /opt/kot/.env on Oracle VM only if using permanent Base32 QR Setup Key)
# KOTAK_UCC=""
# KOTAK_MOBILE=""
# KOTAK_CONSUMER_KEY=""
# KOTAK_MPIN=""
# KOTAK_TOTP_SECRET=""
